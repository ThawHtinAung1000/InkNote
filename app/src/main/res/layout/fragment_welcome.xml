<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcome_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inknest_background"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:id="@+id/welcome_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="48dp"
            app:layout_constraintWidth_max="480dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_welcome_logo"
                android:padding="18dp"
                android:src="@drawable/ic_welcome_feather"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/welcome_brand"
                android:textAppearance="@style/TextAppearance.InkNest.Welcome.Brand" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:scaleType="centerInside"
                android:layout_marginTop="28dp"
                android:src="@drawable/illustration_welcome_notebook"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/welcome_headline"
                android:textAppearance="@style/TextAppearance.InkNest.Welcome.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/welcome_subhead"
                android:textAppearance="@style/TextAppearance.InkNest.Welcome.Subhead" />

            <LinearLayout
                style="@style/Widget.InkNest.Welcome.BenefitRow"
                android:layout_marginTop="28dp">

                <ImageView
                    style="@style/Widget.InkNest.Welcome.BenefitIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_welcome_offline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_offline_title"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/welcome_offline_description"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitDescription" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.InkNest.Welcome.BenefitRow"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/Widget.InkNest.Welcome.BenefitIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_welcome_photo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_photo_title"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/welcome_photo_description"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitDescription" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.InkNest.Welcome.BenefitRow"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/Widget.InkNest.Welcome.BenefitIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_welcome_share" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_share_title"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/welcome_share_description"
                        android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitDescription" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_writing"
                style="@style/Widget.InkNest.Welcome.StartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/welcome_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skip_introduction"
                style="@style/Widget.InkNest.Welcome.SkipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/welcome_skip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:drawableStartCompat="@drawable/ic_welcome_lock"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="@string/welcome_reassurance"
                android:textAppearance="@style/TextAppearance.InkNest.Welcome.BenefitDescription" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
