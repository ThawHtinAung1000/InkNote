<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.InkNest.Library" parent="TextAppearance.InkNest.Welcome">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Brand">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Heading">
        <item name="android:textSize">26sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineHeight">22sp</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Excerpt">
        <item name="android:textColor">@color/inknest_on_surface_variant</item>
        <item name="android:lineHeight">22sp</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/inknest_muted_foreground</item>
        <item name="android:lineHeight">18sp</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Status">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/inknest_muted_foreground</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Section">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/inknest_muted_foreground</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.07</item>
    </style>
    <style name="TextAppearance.InkNest.Library.Nav">
        <item name="android:textSize">11sp</item>
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="Widget.InkNest.Library.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="Widget.InkNest.Library.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/inknest_primary</item>
    </style>
    <style name="ShapeAppearanceOverlay.InkNest.LibraryFab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
