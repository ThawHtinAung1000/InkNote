<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.InkNest.Editor" parent="TextAppearance.InkNest.Welcome">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.InkNest.Editor.ScreenTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.InkNest.Editor.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/inknest_muted_foreground</item>
    </style>
    <style name="TextAppearance.InkNest.Editor.Section">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:textColor">@color/inknest_muted_foreground</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="TextAppearance.InkNest.Editor.BannerTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/inknest_primary</item>
    </style>
    <style name="Widget.InkNest.Editor.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/inknest_foreground</item>
        <item name="android:textColorHint">@color/inknest_muted_foreground</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">top|start</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
    </style>
    <style name="Widget.InkNest.Editor.IconButton" parent="Widget.InkNest.Library.IconButton">
        <item name="android:padding">12dp</item>
    </style>
    <style name="Widget.InkNest.Editor.SaveButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/inknest_primary</item>
        <item name="android:textColor">@color/inknest_primary_foreground</item>
        <item name="cornerRadius">20dp</item>
    </style>
    <style name="Widget.InkNest.Editor.FormatButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/editor_format_icon_tint</item>
        <item name="backgroundTint">@color/editor_format_background</item>
        <item name="android:checkable">true</item>
    </style>
    <style name="Widget.InkNest.Editor.AddPhotoButton" parent="Widget.InkNest.Editor.SaveButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="backgroundTint">@color/inknest_card</item>
        <item name="android:textColor">@color/inknest_primary</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/inknest_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="icon">@drawable/ic_welcome_photo</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/inknest_primary</item>
    </style>
</resources>
